{
	"compilerOptions": {
		"target": "ES2020",
		"module": "ESNext",
		"moduleResolution": "bundler",
		"lib": ["ES2020", "DOM"],
		"strict": false,
		"strictNullChecks": true,
		"noImplicitAny": true,
		"skipLibCheck": true,
		"esModuleInterop": true,
		"resolveJsonModule": true,
		"isolatedModules": true,
		"noEmit": true,
		"baseUrl": ".",
		"paths": {
			"@solve-js/*": ["../core/src/*"],
			"@solve-js-examples/*": ["../core/examples/*"]
		}
	},
	"include": ["src/**/*.ts"]
}
