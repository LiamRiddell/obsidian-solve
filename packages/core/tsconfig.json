{
	"compilerOptions": {
		"target": "ES2020",
		"module": "ESNext",
		"moduleResolution": "bundler",
		"lib": ["ES2020", "DOM"],
		"strict": false,
		"strictNullChecks": true,
		"noImplicitAny": true,
		"skipLibCheck": true,
		"esModuleInterop": true,
		"resolveJsonModule": true,
		"isolatedModules": true,
		"declaration": true,
		"baseUrl": ".",
		"paths": {
			"@solve-js/*": ["./src/*"]
		}
	},
	"include": ["src/**/*.ts"],
	"exclude": ["**/__tests__/**/*"]
}
