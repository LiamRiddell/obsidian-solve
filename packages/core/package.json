{
	"name": "@solve/core",
	"version": "0.1.0",
	"description": "The expression evaluation engine behind Solve — lexer, parser, bytecode VM, and an extensible package system.",
	"license": "MIT",
	"type": "module",
	"engines": { "node": ">=18" },
	"files": ["dist"],
	"main": "./dist/index.cjs",
	"module": "./dist/index.js",
	"types": "./dist/index.d.ts",
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"import": "./dist/index.js",
			"require": "./dist/index.cjs"
		},
		"./engine": {
			"types": "./dist/engine.d.ts",
			"import": "./dist/engine.js",
			"require": "./dist/engine.cjs"
		},
		"./vm": {
			"types": "./dist/vm.d.ts",
			"import": "./dist/vm.js",
			"require": "./dist/vm.cjs"
		},
		"./format": {
			"types": "./dist/format.d.ts",
			"import": "./dist/format.js",
			"require": "./dist/format.cjs"
		},
		"./language": {
			"types": "./dist/language.d.ts",
			"import": "./dist/language.js",
			"require": "./dist/language.cjs"
		},
		"./packages": {
			"types": "./dist/packages.d.ts",
			"import": "./dist/packages.js",
			"require": "./dist/packages.cjs"
		},
		"./constants": {
			"types": "./dist/constants.d.ts",
			"import": "./dist/constants.js",
			"require": "./dist/constants.cjs"
		},
		"./lexer": {
			"types": "./dist/lexer.d.ts",
			"import": "./dist/lexer.js",
			"require": "./dist/lexer.cjs"
		},
		"./parser": {
			"types": "./dist/parser.d.ts",
			"import": "./dist/parser.js",
			"require": "./dist/parser.cjs"
		},
		"./normalizer": {
			"types": "./dist/normalizer.d.ts",
			"import": "./dist/normalizer.js",
			"require": "./dist/normalizer.cjs"
		},
		"./variables": {
			"types": "./dist/variables.d.ts",
			"import": "./dist/variables.js",
			"require": "./dist/variables.cjs"
		},
		"./resolvers": {
			"types": "./dist/resolvers.d.ts",
			"import": "./dist/resolvers.js",
			"require": "./dist/resolvers.cjs"
		},
		"./errors": {
			"types": "./dist/errors.d.ts",
			"import": "./dist/errors.js",
			"require": "./dist/errors.cjs"
		},
		"./utilities": {
			"types": "./dist/utilities.d.ts",
			"import": "./dist/utilities.js",
			"require": "./dist/utilities.cjs"
		},
		"./uom": {
			"types": "./dist/uom.d.ts",
			"import": "./dist/uom.js",
			"require": "./dist/uom.cjs"
		},
		"./services": {
			"types": "./dist/services.d.ts",
			"import": "./dist/services.js",
			"require": "./dist/services.cjs"
		}
	},
	"scripts": {
		"build": "tsup",
		"dev": "tsup --watch"
	},
	"dependencies": {
		"@tanstack/query-core": "^5.100.10"
	},
	"devDependencies": {
		"tsup": "8.5.1",
		"typescript": "5.1.6"
	}
}
