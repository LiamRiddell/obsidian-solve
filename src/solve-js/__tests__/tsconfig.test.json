{
  "compilerOptions": {
    "allowSyntheticDefaultImports": true,
    "esModuleInterop": true,
    "baseUrl": "../../..",
    "paths": {
      "@/*": ["src/*"],
      "@app/*": ["src/app/*"],
      "@solve-js/*": ["src/solve-js/src/*"],
      "test/*": ["src/solve-js/__tests__/*"]
    },
    "target": "ES6",
    "module": "ESNext",
    "moduleResolution": "node",
    "strictNullChecks": true,
    "allowJs": true,
    "noImplicitAny": true,
    "isolatedModules": true,
    "importHelpers": true,
    "inlineSourceMap": true,
    "inlineSources": true,
    "skipLibCheck": true
  },
  "exclude": ["node_modules"]
}