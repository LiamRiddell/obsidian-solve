{
  "compilerOptions": {
    "allowSyntheticDefaultImports": true,
    "esModuleInterop": true,
    "baseUrl": "..",
    "paths": {
      "@/*": ["src/*"],
      "@app/*": ["src/app/*"]
    },
    "target": "ES6",
    "module": "ESNext",
    "moduleResolution": "node",
    "strictNullChecks": true,
    "allowJs": true,
    "noImplicitAny": true,
    "isolatedModules": true,
    "importHelpers": true,
    "inlineSourceMap": true,
    "inlineSources": true,
    "skipLibCheck": true
  },
  "exclude": ["node_modules"]
}
