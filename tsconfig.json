{
	"compilerOptions": {
		"allowSyntheticDefaultImports": true,
		"esModuleInterop": false,
		"baseUrl": ".",
		"inlineSourceMap": true,
		"inlineSources": true,
		"module": "ESNext",
		"target": "ES6",
		"allowJs": true,
		"noImplicitAny": true,
		"moduleResolution": "bundler",
		"importHelpers": true,
		"isolatedModules": true,
		"skipLibCheck": true,
		"strictNullChecks": true,
		"lib": ["DOM", "ES5", "ES6", "ES7"],
"paths": {
		"@/*": ["src/*"],
		"@app/*": ["src/app/*"]
	}
	},
	"include": ["**/*.ts"],
	"exclude": ["playground/**/*", "webapp/**/*", "packages/**/*", "**/__tests__/**/*", "**/*.spec.ts"]
}
