{
	"name": "solve",
	"version": "2.0.1",
	"description": "Supercharge your notes with real-time calculations without AI fuss. From dates ('Now + 20 days'), percentages ('10% of 120'), units of measurement ('100cm + 2m'), arithmetic ('10 + 5') and more!",
	"main": "main.js",
	"scripts": {
		"dev": "node esbuild.config.mjs",
		"lint": "npx eslint --fix src",
		"build": "tsc -noEmit -skipLibCheck && node esbuild.config.mjs production",
		"test": "node --expose-gc ./node_modules/.bin/jest --logHeapUsage",
		"test:ci": "node --expose-gc ./node_modules/.bin/jest --no-coverage --logHeapUsage",
		"test:watch": "jest --watch",
		"test:debug": "node --expose-gc ./node_modules/.bin/jest --no-coverage --verbose --logHeapUsage",
		"typecheck": "tsc --noEmit",
		"version": "node version-bump.mjs && git add manifest.json versions.json"
	},
	"keywords": [],
	"author": "Liam Riddell",
	"license": "MIT",
	"devDependencies": {
		"@codemirror/autocomplete": "6.20.3",
		"@jest/globals": "^29.6.2",
		"@lezer/common": "^1.0.3",
		"@types/node": "16.18.39",
		"@typescript-eslint/eslint-plugin": "6.2.0",
		"@typescript-eslint/parser": "6.2.0",
		"builtin-modules": "3.3.0",
		"esbuild": "0.18.17",
		"esbuild-plugin-inline-worker": "^0.1.1",
		"eslint": "8.45.0",
		"jest": "^29.6.2",
		"moment": "^2.29.4",
		"obsidian": "latest",
		"prettier": "3.0.0",
		"ts-jest": "^29.1.1",
		"tslib": "2.6.1",
		"typescript": "5.1.6"
	},
	"dependencies": {
		"@tanstack/query-core": "^5.100.10",
		"animate.css": "^4.1.1",
		"convert": "^7.0.0",
		"solve-engine": "1.1.0"
	}
}
