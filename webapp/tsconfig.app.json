{
  "compilerOptions": {
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.app.tsbuildinfo",
    "target": "es2023",
    "lib": ["ES2023", "DOM"],
    "module": "esnext",
    "types": ["vite/client", "node"],
    "allowArbitraryExtensions": true,
    "skipLibCheck": true,

    /* Bundler mode */
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "moduleDetection": "force",
    "noEmit": true,
    "jsx": "react-jsx",

    /* Path aliases (shadcn/ui + shared engine packages) — no baseUrl needed,
       paths resolve relative to this file (deprecated in TS 6.0). The
       @bridge/@solve-js aliases pull packages/playground-bridge and
       packages/core source into this project's type-check transitively —
       those packages have their own, more lenient tsconfigs and were never
       written to satisfy Vite's react-ts template defaults
       (verbatimModuleSyntax/erasableSyntaxOnly/noUnusedLocals), so those
       are intentionally left off here rather than forced onto code outside
       this package's own boundary. */
    "paths": {
      "@/*": ["./src/*"],
      "@bridge/*": ["../packages/playground-bridge/src/*"],
      "@solve-js/*": ["../packages/core/src/*"],
      "@solve-js-examples/*": ["../packages/core/examples/*"]
    },

    "noFallthroughCasesInSwitch": true
  },
  "include": ["src"]
}
